# This project's settings on this machine. Copy this file to .env, in this
# directory, and change what you need. Without a .env, these defaults apply.
# Docker Compose and the scripts in bin/ read .env; the shop never sees it.

# nginx: the shop at http://localhost:8000. Change it when another project
# already holds the port. APP_URL in the shop's .env.local and the domain of
# its sales channel have to change with it.
SHOPWARE_DEV_HTTP_PORT=8000

# MySQL: a database GUI connects to localhost:3306. Change it when another
# project already holds the port.
SHOPWARE_DEV_DB_PORT=3306

# Mailpit: the mails the shop sent, at http://localhost:8025. Change it when
# another project already holds the port.
SHOPWARE_DEV_MAIL_PORT=8025

# The name of this project's containers, images and volumes: the project
# folder's name plus -shopware-development. Set it when another project has a
# folder of the same name; the scripts stop and say so when that happens.
# SHOPWARE_DEV_PROJECT_ID=webshop-shopware-development
