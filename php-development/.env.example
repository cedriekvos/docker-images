# This project's settings on this machine. Copy this file to .env, in this
# directory, and change what you need. Without a .env, these defaults apply.
# Docker Compose and the scripts in bin/ read .env; the application never
# sees it.

# nginx: the application at http://localhost:8000. Change it when another
# project already holds the port.
PHP_DEV_HTTP_PORT=8000

# PostgreSQL: a database GUI connects to localhost:5432. Change it when
# another project already holds the port.
PHP_DEV_DB_PORT=5432

# The name of this project's containers, images and volumes: the project
# folder's name plus -php-development. Set it when another project has a
# folder of the same name; the scripts stop and say so when that happens.
# PHP_DEV_PROJECT_ID=webshop-php-development
